# Backend (Express) — ตั้งค่าเหล่านี้ใน Render → Environment
# (อย่า commit ค่าจริงขึ้น GitHub — ใส่ผ่าน dashboard เท่านั้น)

# MongoDB Atlas connection string (มีอยู่แล้วในเครื่อง)
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxx.mongodb.net/?appName=Cluster0

# Render กำหนด PORT ให้เองอัตโนมัติ — ไม่ต้องตั้งก็ได้ (server.js ใช้ process.env.PORT)
PORT=5001

# Email (SMTP) สำหรับ OTP / notification
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM_NAME=InGreen
SMTP_FROM_EMAIL=your-email@gmail.com

# Demo mode (ทดสอบหลาย user ในเครื่องเดียว) — production ควรเอาออก/ตั้ง false
DEMO_VOTER_IP_FROM_HEADER=true

# ── AI สแกนใบเสร็จ — เลือก provider อัตโนมัติ: Gemini (ฟรี) → Claude → mock ──
# ถ้าไม่ใส่ key ใดเลย ระบบจะ fallback เป็น mock อัตโนมัติ (ไม่พัง)

# [แนะนำ/ฟรี] Google Gemini — สร้าง key ที่ aistudio.google.com (ไม่ต้องผูกบัตร)
GEMINI_API_KEY=AIzaxxxxxxxx
GEMINI_MODEL=gemini-2.0-flash

# [ทางเลือก/เสียเงิน] Claude vision — ถ้าใส่ทั้งคู่ Gemini จะถูกใช้ก่อน
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
AI_SCAN_MODEL=claude-sonnet-5

# ── เสียงพูด Neural (Google Cloud Text-to-Speech) ─────────────────────────
# ถ้าไม่ใส่ GOOGLE_TTS_API_KEY แอปจะใช้เสียงเบราว์เซอร์แทนอัตโนมัติ
# สร้าง key: Google Cloud Console → เปิด "Cloud Text-to-Speech API" → API key
GOOGLE_TTS_API_KEY=AIzaxxxxxxxx
# เสียงเริ่มต้น (เปลี่ยนได้): th-TH-Neural2-C หรือ Chirp3-HD เช่น th-TH-Chirp3-HD-Achernar
GOOGLE_TTS_VOICE_TH=th-TH-Neural2-C
GOOGLE_TTS_VOICE_EN=en-US-Neural2-F
GOOGLE_TTS_RATE=1.0
GOOGLE_TTS_PITCH=0
